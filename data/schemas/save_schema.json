{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoralReefIdleV3 M14-T01 Save Schema",
  "type": "object",
  "required": [
    "save_version",
    "last_save_unix_time",
    "economy",
    "water_chemistry",
    "time",
    "unlocks",
    "livestock",
    "equipment"
  ],
  "properties": {
    "save_version": {
      "type": "integer",
      "minimum": 1
    },
    "save_schema": {
      "type": "string"
    },
    "last_save_unix_time": {
      "type": "integer",
      "minimum": 0
    },
    "player": {
      "type": "object",
      "properties": {
        "reputation": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "economy": {
      "type": "object"
    },
    "water_chemistry": {
      "type": "object"
    },
    "time": {
      "type": "object"
    },
    "unlocks": {
      "type": "object"
    },
    "livestock": {
      "type": "object",
      "properties": {
        "owned_livestock": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tank_level": {
          "type": "integer"
        },
        "max_capacity": {
          "type": "number"
        },
        "current_capacity_used": {
          "type": "number"
        },
        "maintenance_health": {
          "type": "number"
        }
      }
    },
    "equipment": {
      "type": "object"
    },
    "dock_state": {
      "type": "object",
      "properties": {
        "next_arrival": {
          "type": "integer"
        },
        "current_rescue_id": {
          "type": "string"
        },
        "rng_seed": {
          "type": "integer"
        }
      }
    },
    "rescue_data": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer"
        },
        "dock_state": {
          "type": "object"
        },
        "active_rescue": {
          "type": "object"
        },
        "completed_rescues": {
          "type": "array"
        },
        "codex_rescue_marks": {
          "type": "object"
        },
        "ecological_reputation": {
          "type": "integer"
        },
        "total_release_rp_reward": {
          "type": "integer"
        },
        "release_reward_sum_reputation": {
          "type": "integer"
        },
        "event_log": {
          "type": "array"
        },
        "rng_state": {
          "type": "integer"
        }
      }
    }
  },
  "additionalProperties": false
}
