{
  "schema_version": 1,
  "description": "M16-T01 rescue visual card manifest contract. T01 accepts placeholder assets only.",
  "required_top_level_fields": [
    "schema_version",
    "max_entries",
    "cards"
  ],
  "card_required_fields": [
    "species_id",
    "asset_path",
    "sha256",
    "source",
    "gen_info"
  ],
  "source_allowed": [
    "placeholder"
  ],
  "constraints": {
    "max_entries_equals_species_rescue_pool_count": true,
    "species_id_must_exist_in_species_rescue_pool": true,
    "asset_path_must_be_res_path": true,
    "asset_filename_ascii_only": true,
    "sha256_must_match_actual_file": true,
    "no_save_fields": true,
    "no_real_art_sources_in_t01": true
  }
}
