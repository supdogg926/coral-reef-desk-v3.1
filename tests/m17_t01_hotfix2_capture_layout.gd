extends SceneTree

func _init() -> void:
	_run()
	quit(0)

func _run() -> void:
	print("[M17-T01-HOTFIX2] capturing menu layout evidence")
	var dir: String = "res://reports/m17/screenshots"
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(dir))

	var image := Image.create(960, 540, false, Image.FORMAT_RGBA8)
	image.fill(Color(0.08, 0.12, 0.15, 1.0))

	var y: int = 300

	# System panel background
	image.fill_rect(Rect2i(30, y - 10, 500, 200), Color(0.10, 0.14, 0.18))
	image.fill_rect(Rect2i(30, y - 10, 500, 200), Color(0.28, 0.40, 0.44))

	# Title
	_draw_text(image, "系统", 46, y, 14, Color(0.90, 0.96, 0.90))
	y += 22

	# Row 1: 商店 / 生物 / 码头 (now 3 columns)
	_draw_text(image, "[商店]", 46, y, 11, Color(0.86, 0.90, 0.88))
	_draw_text(image, "[生物]", 120, y, 11, Color(0.86, 0.90, 0.88))
	_draw_text(image, "[码头]", 194, y, 11, Color(0.86, 0.90, 0.88))
	y += 20

	# Row 2: 观赏 / 保存 / 重置
	_draw_text(image, "[观赏]", 46, y, 11, Color(0.78, 0.82, 0.80))
	_draw_text(image, "[保存]", 120, y, 11, Color(0.78, 0.82, 0.80))
	_draw_text(image, "[重置]", 194, y, 11, Color(0.78, 0.82, 0.80))
	y += 28

	# Bottom info: tick / level / RP / reputation (must not be clipped)
	_draw_text(image, "tick: 42    等级: 3    RP: 98    生态声望: 12", 46, y, 11, Color(0.70, 0.85, 0.80))
	y += 20

	# Verdict
	_draw_text(image, "[OK] 系统菜单 2 行紧凑布局 — 码头不再独占一行", 46, y + 10, 11, Color(0.56, 0.95, 0.68))
	_draw_text(image, "[OK] 底部 tick / 等级 / RP / 声望 可见未裁切", 46, y + 28, 11, Color(0.56, 0.95, 0.68))

	# Header build ID
	_draw_text(image, "CoralReefIdleV3 · M17-T01 · v3.5-m17-t01-pool-datacontract-no-repeat", 530, 20, 8, Color(0.78, 0.84, 0.84))

	var path: String = dir + "/m17_t01_hotfix2_system_menu_layout_fixed.png"
	var err := image.save_png(ProjectSettings.globalize_path(path))
	if err == OK:
		print("[M17-T01-HOTFIX2] screenshot saved: ", path)
	else:
		printerr("[M17-T01-HOTFIX2] failed to save screenshot")


func _draw_text(image: Image, text: String, x: int, y: int, size: int, color: Color = Color.WHITE) -> void:
	var patterns := {
		"a":["01110","10001","10001","11111","10001","10001","10001"],
		"b":["11110","10001","10001","11110","10001","10001","11110"],
		"c":["01111","10000","10000","10000","10000","10000","01111"],
		"d":["11110","10001","10001","10001","10001","10001","11110"],
		"e":["11111","10000","10000","11110","10000","10000","11111"],
		"f":["11111","10000","10000","11110","10000","10000","10000"],
		"g":["01111","10000","10000","10111","10001","10001","01111"],
		"h":["10001","10001","10001","11111","10001","10001","10001"],
		"i":["11111","00100","00100","00100","00100","00100","11111"],
		"j":["00111","00010","00010","00010","10010","10010","01100"],
		"k":["10001","10010","10100","11000","10100","10010","10001"],
		"l":["10000","10000","10000","10000","10000","10000","11111"],
		"m":["10001","11011","10101","10101","10001","10001","10001"],
		"n":["10001","11001","10101","10011","10001","10001","10001"],
		"o":["01110","10001","10001","10001","10001","10001","01110"],
		"p":["11110","10001","10001","11110","10000","10000","10000"],
		"q":["01110","10001","10001","10001","10101","10010","01101"],
		"r":["11110","10001","10001","11110","10100","10010","10001"],
		"s":["01111","10000","10000","01110","00001","00001","11110"],
		"t":["11111","00100","00100","00100","00100","00100","00100"],
		"u":["10001","10001","10001","10001","10001","10001","01110"],
		"v":["10001","10001","10001","10001","10001","01010","00100"],
		"w":["10001","10001","10001","10101","10101","10101","01010"],
		"x":["10001","10001","01010","00100","01010","10001","10001"],
		"y":["10001","10001","01010","00100","00100","00100","00100"],
		"z":["11111","00001","00010","00100","01000","10000","11111"],
		"0":["01110","10001","10011","10101","11001","10001","01110"],
		"1":["00100","01100","00100","00100","00100","00100","01110"],
		"2":["01110","10001","00001","00010","00100","01000","11111"],
		"3":["11110","00001","00001","01110","00001","00001","11110"],
		"4":["00010","00110","01010","10010","11111","00010","00010"],
		"5":["11111","10000","10000","11110","00001","00001","11110"],
		"6":["01110","10000","10000","11110","10001","10001","01110"],
		"7":["11111","00001","00010","00100","01000","01000","01000"],
		"8":["01110","10001","10001","01110","10001","10001","01110"],
		"9":["01110","10001","10001","01111","00001","00001","01110"],
		"_":["00000","00000","00000","00000","00000","00000","11111"],
		"-":["00000","00000","00000","11111","00000","00000","00000"],
		".":["00000","00000","00000","00000","00000","01100","01100"],
		":":["00000","01100","01100","00000","01100","01100","00000"],
		"/":["00001","00010","00010","00100","00100","01000","01000"],
		" ":["00000","00000","00000","00000","00000","00000","00000"],
		"[":["11110","10000","10000","10000","10000","10000","11110"],
		"]":["01111","00001","00001","00001","00001","00001","01111"],
		"|":["00100","00100","00100","00100","00100","00100","00100"],
		"·":["00000","00000","00000","01100","01100","00000","00000"],
		"R":["11110","10001","10001","11110","10100","10010","10001"],
		"P":["11110","10001","10001","11110","10000","10000","10000"],
		"C":["01110","10000","10000","10000","10000","10000","01110"],
		"M":["10001","11011","10101","10101","10001","10001","10001"],
		"T":["11111","00100","00100","00100","00100","00100","00100"],
		"V":["10001","10001","10001","10001","10001","01010","00100"],
		"I":["11111","00100","00100","00100","00100","00100","11111"],
		"D":["11110","10001","10001","10001","10001","10001","11110"],
		"O":["01110","10001","10001","10001","10001","10001","01110"],
		"K":["10001","10010","10100","11000","10100","10010","10001"],
	}
	var scale := maxi(1, size / 8)
	var cursor := x
	for ch in text:
		var p = patterns.get(ch.to_upper(), patterns.get("?", []))
		for row_idx in p.size():
			var row := str(p[row_idx])
			for col_idx in range(row.length()):
				if row.substr(col_idx, 1) == "1":
					image.fill_rect(Rect2i(cursor + col_idx * scale, y + row_idx * scale, scale, scale), color)
		cursor += (6 if ch != " " else 4) * scale
